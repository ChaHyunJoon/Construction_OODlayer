{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_proposal.schema.json",
  "title": "ToolProposal",
  "description": "Envelope of one generated repair tool (design 2026-09-24 section 4). The executable substance is impl_code + calls; claimed_effects and any self-reported success are reference only and grant nothing. params and call args may be {} -- the body reads targets/coordinates/IDs from env sensors at run time. Field names reuse the current synthesis record (tool_name, impl_name, impl_code, params, calls, surface, reversible). Validated in Julia by src/verification/repair_types.jl (same file, no second copy of the rules). No geometry-patch fields: GeometryPatch belongs to the auxiliary G4 arm only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_id", "proposal_id", "submission_index",
               "tool_name", "specification", "impl_name", "impl_code", "params", "calls"],
  "properties": {
    "schema_version": {"const": "tool-proposal/1"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "parent_proposal_id": {"type": ["string", "null"], "minLength": 1},
    "submission_index": {"type": "integer", "minimum": 1},
    "tool_name": {"type": "string", "minLength": 1},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "preserves": {"type": "array", "items": {"type": "string"}}
      }
    },
    "impl_name": {"type": "string", "minLength": 2, "pattern": "!$"},
    "impl_code": {"type": "string", "minLength": 1},
    "params": {"type": "object"},
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive", "args"],
        "properties": {
          "primitive": {"type": "string", "minLength": 1},
          "args": {"type": "object"}
        }
      }
    },
    "claimed_effects": {"type": "array", "items": {"type": "string"}},
    "surface": {"type": "string"},
    "reversible": {"type": "boolean"},
    "provenance": {"type": "object"}
  }
}
