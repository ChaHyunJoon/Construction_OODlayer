-    $faulted = @($robots | Where-Object mode -eq "FAULT").Count
-
-    $scenario = $file.BaseName -replace "^.*__", ""
-    $expected = if ($expectedOod.ContainsKey($scenario)) {
-        $expectedOod[$scenario]
-    } else {
-        $ood.Count
-    }
-
-    [pscustomobject]@{
-        Scenario = $scenario
-        Complete = "$done/$($assemblies.Count)"
-        OOD = $ood.Count
-        Respec = $history.Count
-        Depleted = $depleted
-        Faulted = $faulted
-        FinalStep = $frame.t
-        Pass = (
